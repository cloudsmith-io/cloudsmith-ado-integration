{
  "manifestVersion": 1,
  "id": "cloudsmith-cli-install",
  "publisher": "Cloudsmith",
  "version": "1.0.0",
  "name": "Cloudsmith CLI Install",
  "description": "This extension installs the Cloudsmith CLI to the build agent.",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "categories": [
    "Azure Pipelines"
  ],
  "icons": {
    "default": "CloudsmithSymbol--RGB@S.png"
  },
  "files": [
    {
      "path": "cloudsmith-cli-install-task",
      "addressable": true
    }
  ],
  "public": true,
  "details": {
    "path": "overview.md"
  },
  "links": {
    "privacy": {
      "uri": "https://help.cloudsmith.io/docs/individual-privacy-policy"
    },
    "license": {
      "uri": "https://help.cloudsmith.io/docs/contributor-license-agreement"
    },
    "support": {
      "uri": "https://help.cloudsmith.io"
    }
  },
  "contributions": [
    {
      "id": "cloudsmith-cli-install",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "cloudsmith-cli-install-task"
      }
    }
  ]
}