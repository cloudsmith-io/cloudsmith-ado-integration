{
  "manifestVersion": 1,
  "id": "CloudsmithCliSetupAndAuthenticate",
  "publisher": "Cloudsmith",
  "version": "2.1.0",
  "name": "Cloudsmith CLI Setup & Authenticate",
  "description": "An Azure DevOps extension to install the standalone Cloudsmith CLI and authenticate using API Key or OIDC.",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "categories": [
    "Azure Pipelines"
  ],
  "icons": {
    "default": "images/icon.png"
  },
  "files": [
    {
      "path": "cloudsmith-task",
      "addressable": true
    }
  ],
  "public": true,
  "details": {
    "path": "overview.md"
  },
  "links": {
    "privacy": {
      "uri": "https://trust.cloudsmith.com/"
    },
    "license": {
      "uri": "https://github.com/cloudsmith-io/cloudsmith-ado-integration/blob/main/LICENSE"
    },
    "support": {
      "uri": "https://support.cloudsmith.com/"
    }
  },
  "contributions": [
    {
      "id": "cloudsmith-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "cloudsmith-task"
      }
    }
  ]
}