{
  "manifestVersion": 1,
  "id": "Cloudsmith",
  "publisher": "Cloudsmith",
  "version": "1.0.0",
  "name": "Cloudsmith CLI Install",
  "description": "This extension installs the Cloudsmith CLI to the build agent.",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "categories": [
    "Azure Pipelines"
  ],
  "icons": {
    "default": "CloudsmithSymbol--RGB@S.png"
  },
  "files": [
    {
      "path": "cloudsmith-cli-install-task",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "cloudsmith-cli-install-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "cloudsmith-cli-install-task"
      }
    }
  ]
}